# ============================================================
# lohasauto 환경설정 **서식** — 실제 .env 는 올리지 않는다
#   이 파일을 .env 로 복사한 뒤 빈 칸을 채우십시오.
#   비어 있는 항목이 비밀값입니다 (비밀번호·API 키·계정번호).
# ============================================================

# ---- 로하스 로그인 계정 ----
LOHAS_ID=
LOHAS_PW=

# ---- 브라우저 ----
# 헤드리스 기본값 (GUI 체크박스로 매 실행마다 변경 가능)
HEADLESS=0
# 브라우저를 띄울 모니터 번호 (1부터). 0 이면 기본 동작.
# 프로그램 창을 띄울 모니터 (1부터, 0=주 모니터)
GUI_MONITOR=0
BROWSER_MONITOR=2
# chromedriver 를 직접 지정할 때만 사용 (비워두면 Selenium Manager 자동)
CHROME_DRIVER_PATH=
# 로그인 쿠키 저장/재사용 (1=사용). 실패 시 자동으로 일반 로그인
USE_COOKIE_LOGIN=1
# 페이지당 조회 개수
PAGE_SIZE=1000
# 점검 시 최대 페이지 수 (무한루프 방지)
MAX_PAGES=100

# ---- Gemini (키워드 선택 AI) ----
# https://aistudio.google.com/apikey 에서 발급. 비워두면 규칙 기반으로만 동작.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_MIN_INTERVAL=4   # 호출 최소 간격(초) - 429 예방
GEMINI_MAX_IMAGES=1   # 선택 시 보낼 이미지 장수 (토큰 절감)
GEMINI_VERIFY=1   # 2차 검수 호출 사용
GEMINI_VERIFY_IMAGES=0   # 검수에는 이미지 미첨부 (토큰 절반 절감)
GEMINI_RETRIES=3

# ---- 키워드 선택 규칙 ----
MAX_TAGS=10
MAX_TITLE_KW=4

# ---- 상품분석(ALL) ----
ANALYSIS_BATCH=20
ANALYSIS_POLL=10
ANALYSIS_TIMEOUT=300

# ---- 자체 DB (SQLite) : 기본 저장소 ----
SQLITE_PATH=data/lohasauto.db

# ---- 미러링용 MySQL (선택) ----
# MYSQL_ENABLED=1 이면 SQLite 에만 저장합니다.
# ---- 접속 위치 (사내망 / 외부망) ----
# 로하스 사이트와 분석/태그 API(:3403)는 공인 IP라 어디서든 된다.
# MySQL 미러와 데이터랩 서버만 사내 IP라 외부망에서는 따로 열어줘야 한다.
#
#   auto      사내 MySQL 에 잠깐 접속해보고 되면 internal, 안 되면 external
#   internal  항상 사내
#   external  항상 외부
NET_PROFILE=auto
NET_PROBE_TIMEOUT=1.2

# ---- MySQL 미러 (사내) ----
DB_HOST_INTERNAL=192.168.219.200
DB_PORT_INTERNAL=3306

# ---- MySQL 미러 (외부) ----
# 터널을 쓰면(TUNNEL_ENABLED=1) 이 값은 무시되고 127.0.0.1 로 붙는다.
# 터널을 안 쓸 때만 쓰이는 직접 접속 주소다.
DB_HOST_EXTERNAL=
DB_PORT_EXTERNAL=3306


# ---- SSH 터널 (외부망 전용) ----
# MySQL 3306 을 인터넷에 직접 여는 대신 SSH 로 끌어온다.
# 외부망 프로파일일 때만 동작한다. 사내에서는 무시된다.
TUNNEL_ENABLED=1
SSH_HOST=
SSH_PORT=22
SSH_USER=
# 비워두면 ai100pw 를 쓴다. 키 인증을 쓰려면 SSH_KEY 에 경로를 적는다.
SSH_PASSWORD=
SSH_KEY=
SSH_KEY_PASSPHRASE=

# 터널이 끌어올 사내 주소
TUNNEL_DB_TARGET=192.168.219.200:3306
TUNNEL_DATALAB_TARGET=192.168.219.100:8900

# 내 PC 에서 열 포트 (집에 MySQL 이 있어도 안 부딪치게 비껴 잡음)
TUNNEL_DB_PORT=13306
TUNNEL_DATALAB_PORT=18900

# ---- 데이터랩 백엔드 (사내) ----
DATALAB_HOST_INTERNAL=192.168.219.100
DATALAB_PORT_INTERNAL=8900

# ---- 데이터랩 백엔드 (외부) ----
# 8900 은 외부에 안 열려 있다(확인함). 열려면 공유기에서 192.168.219.100 로
# 포워딩하거나, SSH 터널(22 는 외부에 열려 있다)로 뚫고 127.0.0.1 을 적는다.
#   ssh -L 8900:192.168.219.100:8900 <계정>@106.247.220.118
# 비워두면 외부망에서 '데이터랩 500' 기능만 꺼진다.
DATALAB_HOST_EXTERNAL=
DATALAB_PORT_EXTERNAL=8900

MYSQL_ENABLED=1
DB_NAME=ads
DB_USER=
DB_PASSWORD=
DB_HOST=192.168.219.200
DB_PORT=3306

## 192.168.219.100 서버 참고용 
ai100id=
ai100pw=
ai100ip=

CUSTOMER_ID=

# ---- 네이버 검색광고 API (연관키워드) ----
# https://searchad.naver.com > 도구 > API 사용관리
NAVER_CUSTOMER_ID=
# naverapikey = ACCESS_KEY, naverpass = SECRET_KEY (기존 이름 유지)
naverapikey=
naverpass=
# ---- 네이버 검색광고 : 읽을 광고계정 ----
# 키 하나로 여러 광고계정을 읽는다 (X-Customer 만 바뀐다).
# 2026-09-11 실측 : 2718735 캠페인 3건 / 4464788 캠페인 10건
NAVER_AD_CUSTOMERS=

# ---- 메일함 (스마트스토어 경고 · 광고비 알림) ----
# ⚠️ 네이트는 POP3 를 영구 종료했다. imap.nate.com:993 만 된다.
# ⚠️ 2단계 인증 계정은 로그인 비밀번호가 아니라 **애플리케이션 비밀번호**.
# ⚠️ 네이버는 메일 환경설정에서 IMAP/POP3 를 '사용함' 으로 켜야 접속된다.
MAIL_DAYS=14

MAIL_1_NAME=네이버
MAIL_1_HOST=imap.naver.com
MAIL_1_PORT=993
MAIL_1_PROTO=imap
MAIL_1_USER=
MAIL_1_PASS=
MAIL_1_FOLDER=INBOX

MAIL_2_NAME=네이트
MAIL_2_HOST=imap.nate.com
MAIL_2_PORT=993
MAIL_2_PROTO=imap
MAIL_2_USER=
MAIL_2_PASS=
MAIL_2_FOLDER=INBOX

# 메일 비밀번호를 .env 에 적지 않고 사내 100번 서버에서 받아온다.
# 비우면 위의 MAIL_n_PASS 를 그대로 쓴다. (사내망에서만 동작)
MAIL_SECRET_SOURCE=ai100

# ---- 광고계정별 API 키 ----
# **키는 광고계정마다 따로 발급된다.** 한 아이디(netkjy)가 여러 계정의
# 책임자여도 다른 계정 번호로 부르면 403 Auth Failed 다 (2026-09-12 실측).
# 계정마다 [도구 > API 사용관리] 에서 받아 아래에 채운다.
#   NAVER_AD_KEY_<계정번호>    = 액세스 라이선스
#   NAVER_AD_SECRET_<계정번호> = 비밀키
# 비워두면 위의 naverapikey/naverpass 를 쓴다.

# 2568098 비트테크노-1   ← 실제 집행 중 (잔액 249,017원)
NAVER_AD_KEY_2568098=
NAVER_AD_SECRET_2568098=
# 2568101 비트테크노-2
NAVER_AD_KEY_2568101=
NAVER_AD_SECRET_2568101=
# 2568103 비트테크노-3
NAVER_AD_KEY_2568103=
NAVER_AD_SECRET_2568103=
# 2568104 비트테크노-4
NAVER_AD_KEY_2568104=
NAVER_AD_SECRET_2568104=
# 2568106 비트테크노-5
NAVER_AD_KEY_2568106=
NAVER_AD_SECRET_2568106=
# 2429609 (주)비트정보통신
NAVER_AD_KEY_2429609=
NAVER_AD_SECRET_2429609=
# 2332804 joys01
NAVER_AD_KEY_2332804=
NAVER_AD_SECRET_2332804=
# 956454 바둑이하우스
NAVER_AD_KEY_956454=
NAVER_AD_SECRET_956454=

# ============================================================
# 광고계정 목록 — **여기에 CUSTOMER_ID 를 채워 주십시오**
# ============================================================
# 위의 키 7개를 교차로 시험해 보니 **결과가 전부 같았다**(2026-09-12).
# 키는 광고계정별이 아니라 **로그인 아이디(netkjy) 단위**다. 그래서 키는
# 위의 것 하나면 되고, 모자란 것은 계정마다의 CUSTOMER_ID 뿐이다.
#
# 광고주센터 계정 목록의 괄호 숫자(2568098 등)는 **화면 표시용이라 안 된다.**
# 각 계정으로 들어가 [도구 > API 사용관리] 에 적힌 CUSTOMER_ID 를 넣는다.
#
#   NAVER_AD_CID_n   그 계정의 CUSTOMER_ID   ← 채울 곳
#   NAVER_AD_NAME_n  화면에 표시할 이름
#
# 채운 줄만 읽는다. 빈칸은 그냥 건너뛴다.

NAVER_AD_NAME_1=
NAVER_AD_CID_1=

NAVER_AD_NAME_2=
NAVER_AD_CID_2=

NAVER_AD_NAME_3=
NAVER_AD_CID_3=

NAVER_AD_NAME_4=
NAVER_AD_CID_4=

NAVER_AD_NAME_5=
NAVER_AD_CID_5=

NAVER_AD_NAME_6=
NAVER_AD_CID_6=

NAVER_AD_NAME_7=
NAVER_AD_CID_7=

NAVER_AD_NAME_8=
NAVER_AD_CID_8=

# 비즈채널로 확인한 계정 (2026-09-12)
#   4464779 비트테크노  · smartstore.naver.com/bitmind   ← 집행 중
#   4464788 비트테크5   · smartstore.naver.com/bitmind   ← 같은 스토어, 상품 0개
#   4243977 비트정보통신 · smartstore.naver.com/joysfeel1
NAVER_AD_NAME_9=
NAVER_AD_CID_9=

NAVER_AD_NAME_10=
NAVER_AD_CID_10=

# 위 CID 를 다 비워두면 이 목록을 쓴다 (예전 방식)
NAVER_AD_CUSTOMERS=

# ---- 네이버 커머스 API (스마트스토어 실매출) ----
# 100번 서버 naverterms 의 스토어 표에서 가져왔다 (2026-09-12).
#   store_url=bitmind / 이름 '조아난' / memo '02비트마인드'
#   광고계정 비트테크노-1(4464779)의 비즈채널과 같은 스토어다.
# 토큰: POST https://api.commerce.naver.com/external/v1/oauth2/token
#   client_secret_sign = bcrypt(f'{client_id}_{timestamp}', salt=secret) 을 base64
COMMERCE_STORE_URL=bitmind
COMMERCE_STORE_NAME=조아난
COMMERCE_CLIENT_ID=
COMMERCE_CLIENT_SECRET=
