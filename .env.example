# .env 샘플 : 이 파일을 .env 로 복사한 뒤 값을 채우세요.

# ---- 로하스 로그인 계정 ----
LOHAS_ID=
LOHAS_PW=

# ---- 브라우저 ----
HEADLESS=0
CHROME_DRIVER_PATH=
PAGE_SIZE=1000
MAX_PAGES=100

# ---- Gemini (키워드 선택 AI) ----
# https://aistudio.google.com/apikey 에서 발급. 비워두면 규칙 기반으로만 동작.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_MIN_INTERVAL=4      # 호출 최소 간격(초) - 429 예방
GEMINI_MAX_IMAGES=1        # 선택 시 보낼 이미지 장수 (토큰 절감)
GEMINI_VERIFY=1            # 2차 검수 호출 사용
GEMINI_VERIFY_IMAGES=0     # 검수에는 이미지 미첨부 (토큰 절반 절감)
GEMINI_RETRIES=3

# ---- 키워드 선택 규칙 ----
MAX_TAGS=10
MAX_TITLE_KW=4

# ---- 상품분석(ALL) ----
ANALYSIS_BATCH=20
ANALYSIS_POLL=10
ANALYSIS_TIMEOUT=300

# ---- 자체 DB (SQLite) ----
SQLITE_PATH=data/lohasauto.db

# ---- 미러링용 MySQL (선택) ----
# ---- 접속 위치 (사내망 / 외부망) ----
# 로하스 사이트와 분석/태그 API(:3403)는 공인 IP라 어디서든 된다.
# MySQL 미러와 데이터랩 서버만 사내 IP라 외부망에서는 따로 열어줘야 한다.
#
#   auto      사내 MySQL 에 잠깐 접속해보고 되면 internal, 안 되면 external
#   internal  항상 사내
#   external  항상 외부
NET_PROFILE=auto
NET_PROBE_TIMEOUT=1.2

# ---- MySQL 미러 (사내) ----
DB_HOST_INTERNAL=192.168.219.200
DB_PORT_INTERNAL=3306

# ---- MySQL 미러 (외부) ----
# 공유기에서 3306 을 192.168.219.200 로 포워딩하고, 공인 IP 나 DDNS 주소를 적는다.
# 비워두면 외부망에서는 미러가 꺼지고 로컬 SQLite 에만 쌓인다(작업은 정상).
DB_HOST_EXTERNAL=
DB_PORT_EXTERNAL=3306

# ---- 데이터랩 백엔드 (사내) ----
DATALAB_HOST_INTERNAL=192.168.219.100
DATALAB_PORT_INTERNAL=8900

# ---- 데이터랩 백엔드 (외부) ----
# 8900 을 192.168.219.100 로 포워딩한 뒤 주소를 적는다.
# 비워두면 외부망에서 '데이터랩 500' 기능만 꺼진다.
DATALAB_HOST_EXTERNAL=
DATALAB_PORT_EXTERNAL=8900

MYSQL_ENABLED=1
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306

# ---- 네이버 검색광고 : 광고계정 ----
# 광고주센터 [도구 > API 사용관리] 의 CUSTOMER_ID 를 넣는다.
# 계정 목록의 괄호 숫자는 화면 표시용이라 API 에 안 먹는다.
NAVER_AD_NAME_1=
NAVER_AD_CID_1=

# 계정별 키가 따로 있으면 (없으면 naverapikey/naverpass 를 쓴다)
# NAVER_AD_KEY_<계정번호>=
# NAVER_AD_SECRET_<계정번호>=

# ---- 네이버 커머스 API (스마트스토어 실매출) ----
# 토큰 서명: base64(bcrypt(f"{client_id}_{timestamp}", salt=secret))
COMMERCE_STORE_URL=
COMMERCE_STORE_NAME=
COMMERCE_CLIENT_ID=
COMMERCE_CLIENT_SECRET=

# ---- 주문 DB (예비 경로) ----
# 매출 기준은 커머스 API 다. orderdb 로 바꾸면 주문 DB 를 본다.
SALES_SOURCE=
ORDER_DB_HOST=
ORDER_DB_NAME=
ORDER_STORE=

# ---- 메일함 (스마트스토어 경고 · 광고비 알림) ----
# 네이트는 POP3 를 종료했다 — imap.nate.com:993 만 된다.
# 2단계 인증 계정은 애플리케이션 비밀번호를 쓴다.
MAIL_DAYS=14
MAIL_1_NAME=
MAIL_1_HOST=
MAIL_1_PORT=993
MAIL_1_PROTO=imap
MAIL_1_USER=
MAIL_1_PASS=
# 비밀번호를 .env 에 안 적고 사내 서버에서 받아오려면 ai100
MAIL_SECRET_SOURCE=
